          "name": "CreateBooking",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const response = pm.response.json();\r\n\r\npm.test(\"Status code is 200\", function() {\r\n    pm.response.to.be.status(200);\r\n});\r\n\r\npm.test(\"Response booking is correct\", function(){\r\n    console.log(\"First name:   \" + response.booking.firstname);\r\n    pm.expect(response.booking.firstname, \"Unexpected first name\").to.eql(pm.variables.get(\"firstname\"));\r\n    pm.expect(response.booking.lastname, \"Unexpected last name\").to.eql(pm.variables.get(\"lastname\"));\r\n    pm.expect(response.booking.totalprice, \"Unexpected total price\").to.eql(pm.variables.get(\"totalprice\"));\r\n    pm.expect(response.booking.depositpaid, \"Unexpected deposit paid\").to.eql(pm.variables.get(\"depositpaid\"));\r\n    pm.expect(response.booking.bookingdates.checkin, \"Unexpected checkin date\").to.eql(pm.variables.get(\"checkin\"));\r\n    pm.expect(response.booking.bookingdates.checkout, \"Unexpected checkout date\").to.eql(pm.variables.get(\"checkout\"));\r\n    pm.expect(response.booking.additionalneeds, \"Unexpected additional needs\").to.eql(pm.variables.get(\"additionalneeds\"));\r\n});\r\n\r\n//Save booking details\r\npm.environment.set(\"bookingid\", response.bookingid);\r\npm.environment.set(\r\n    \"expectedBooking\",\r\n    JSON.stringify(response.booking)\r\n);\r\n\r\n// Verify saved values in Postman Console\r\nconsole.log(\"Booking ID:\", pm.environment.get(\"bookingid\"));\r\nconsole.log(\"Expected Booking:\", pm.environment.get(\"expectedBooking\"));\r\n"
                ]
              }
            }
          ],
