    {
      "name": "Authentication",
      "item": [
        {
          "name": "CreateToken",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function(){\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Response contains token\", function() {\r\n  var response = pm.response.json();\r\n  pm.expect(response).to.have.property(\"token\");\r\n  pm.environment.set(\"token\",response.token);\r\n  console.log(pm.environment.get(\"token\"));\r\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\" : \"{{admin_username}}\",\n    \"password\" : \"{{admin_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "text"
                }
              }
            },
            "url": {
              "raw": "{{rb_url}}/auth",
              "host": [
                "{{rb_url}}"
              ],
              "path": [
                "auth"
              ]
            }
          },
          "response": []
        }
      ]
    },
